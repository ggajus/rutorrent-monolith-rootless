#!/bin/sh
set -eu

mkdir -p /config/rtorrent
touch /config/rtorrent/rtorrent.log

tail -F /config/rtorrent/rtorrent.log | awk '{
    tmstr = strftime("[%Y-%m-%d %H:%M:%S]", $1)

    level = ($2 == "E") ? "[ERROR]" : ($2 == "W") ? "[WARN]" : "[INFO]"
    hash = substr($3, 1, 6)

    msg = ""
    for (i=4; i<=NF; i++) msg = msg " " $i

    printf "%s %s [%s]%s\n", tmstr, level, hash, msg
    fflush()
}'
